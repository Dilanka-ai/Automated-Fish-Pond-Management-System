    {
        "id": "d9eef6a1d5beef4f",
        "type": "function",
        "z": "e424064ef9f3b795",
        "name": "function 1",
        "func": "// Extract individual sensor values from the incoming message object\nvar sensorData = msg.payload;\n\n// Create individual messages for each sensor value\nvar tdsMsg = { topic: \"TDS\", payload: sensorData.tds };\nvar temperatureMsg = { topic: \"Temperature\", payload: sensorData.temperature };\nvar phMsg = { topic: \"PH\", payload: sensorData.ph };\nvar waterLevelMsg = { topic: \"Water_Level\", payload: sensorData.water_level };\n\n// Output the individual sensor value messages\nreturn [ tdsMsg, temperatureMsg, phMsg, waterLevelMsg];\n",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
