    {
        "id": "7aba8e3d50fdffd7",
        "type": "function",
        "z": "e424064ef9f3b795",
        "name": "Split",
        "func": "// Extract individual sensor values from the incoming message object\nvar sensorData = msg.payload;\n\n// Create individual messages for each sensor value\nvar deviceIdMsg = { topic: \"esp32_data\", payload: sensorData.deviceId };\nvar siteIdMsg = { topic: \"esp32_data\", payload: sensorData.siteId };\nvar tdsMsg = { topic: \"esp32_data\", payload: sensorData.tds };\nvar temperatureMsg = { topic: \"esp32_data\", payload: sensorData.temperature };\nvar phMsg = { topic: \"esp32_data\", payload: sensorData.ph };\nvar waterLevelMsg = { topic: \"esp32_data\", payload: sensorData.water_level };\n\n// Output the individual sensor value messages\nreturn [deviceIdMsg, siteIdMsg, tdsMsg, temperatureMsg, phMsg, waterLevelMsg];\n",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
